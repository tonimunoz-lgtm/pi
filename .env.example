# Copia aquest fitxer a .env.local i omple'l amb les dades de Firebase
# (Configuració del projecte > Les teves aplicacions > Aplicació web).
# Si el deixes buit, l'app funciona en mode demostració (dades al navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Domini del correu del centre (opcional; suggereix el compte correcte al login)
VITE_ALLOWED_DOMAIN=
